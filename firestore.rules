rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // users: private identity and progress; API writes progress and privileges.
    // rankings: public projection; API writes. settings/seasons: API-controlled.
    // questions: five-option, true/false or four-option multiple-answer format.
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.uid == 'ktCddjGUigN8Spm6x9wrdFgzBZy2'; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function text(v,n) { return v is string && v.size()>0 && v.size()<=n; }
    function validIdentity(d,uid) {
      return d.uid==uid && text(d.nome,200) && text(d.email,320) && d.isAdmin is bool
        && text(d.curso,200) && text(d.turma,200) && text(d.unidade,200);
    }
    function identityUnchanged() {
      return request.resource.data.uid==resource.data.uid && request.resource.data.email==resource.data.email
        && request.resource.data.isAdmin==resource.data.isAdmin;
    }
    function option(d,i) { return text(d.alternativas[i],5000); }
    function index(i) { return i is int && i>=0 && i<4; }
    function multiple(d) {
      return d.respostasCorretas is list && d.respostasCorretas.size()>=2 && d.respostasCorretas.size()<=4
        && d.respostasCorretas.toSet().size()==d.respostasCorretas.size()
        && index(d.respostasCorretas[0]) && index(d.respostasCorretas[1])
        && (d.respostasCorretas.size()<3 || index(d.respostasCorretas[2]))
        && (d.respostasCorretas.size()<4 || index(d.respostasCorretas[3]))
        && d.explicacoesAlternativas is list && d.explicacoesAlternativas.size()==4
        && text(d.explicacoesAlternativas[0],10000) && text(d.explicacoesAlternativas[1],10000)
        && text(d.explicacoesAlternativas[2],10000) && text(d.explicacoesAlternativas[3],10000);
    }
    function validQuestion(d) {
      let f=d.get('formato','multipla');
      return d.keys().hasAll(['disciplina','dificuldade','tipo','pergunta','alternativas','explicacao'])
        && d.keys().hasOnly(['disciplina','dificuldade','tipo','pergunta','alternativas','explicacao','formato','respostaCorreta','respostasCorretas','explicacoesAlternativas','fonte','dataReferencia'])
        && d.disciplina in ['Administração e Gestão','Gestão de Pessoas','Gestão Financeira e Contábil','Marketing e Vendas','Empreendedorismo','Materiais e Logística','Produção e Qualidade','Estratégia e Processos','Direito, Legislação e Ética','Tecnologia e Ferramentas Administrativas','Excel','Economia e Atualidades']
        && d.dificuldade in ['Fácil','Médio','Difícil','Especialista']
        && text(d.tipo,200) && text(d.pergunta,10000) && text(d.explicacao,20000)
        && d.alternativas is list && d.alternativas.size()>=2 && d.alternativas.size()<=5
        && d.alternativas.toSet().size()==d.alternativas.size() && option(d,0) && option(d,1)
        && (!('fonte' in d) || (text(d.fonte,2000) && d.fonte.matches('https://[^/@]+/.*')))
        && (!('dataReferencia' in d) || (text(d.dataReferencia,10) && d.dataReferencia.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')))
        && ((f=='vf' && d.alternativas==['Verdadeiro','Falso'] && d.respostaCorreta is int && d.respostaCorreta in [0,1] && !('respostasCorretas' in d) && !('explicacoesAlternativas' in d))
          || (f=='multipla' && d.alternativas.size()==5 && option(d,2) && option(d,3) && option(d,4) && d.respostaCorreta is int && d.respostaCorreta>=0 && d.respostaCorreta<5 && !('respostasCorretas' in d) && !('explicacoesAlternativas' in d))
          || (f=='multipla_resposta' && d.alternativas.size()==4 && option(d,2) && option(d,3) && !('respostaCorreta' in d) && multiple(d)));
    }
    match /users/{uid} {
      allow read: if owner(uid) || admin();
      allow update: if owner(uid) && validIdentity(request.resource.data,uid) && identityUnchanged()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome','curso','turma','unidade']);
      allow create,delete: if false;
    }
    match /rankings/{uid} { allow read: if signedIn(); allow write: if false; }
    match /questions/{id} {
      allow read: if signedIn();
      allow create,update: if admin() && validQuestion(request.resource.data);
      allow delete: if admin();
    }
    match /settings/season { allow read: if signedIn(); allow write: if false; }
    match /seasons/{id} {
      allow read: if signedIn(); allow write: if false;
      match /results/{uid} { allow read: if signedIn(); allow write: if false; }
    }
  }
}
